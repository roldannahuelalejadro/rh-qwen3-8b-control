  "text": "def remove_adjacent_duplicates(lst):\n    # Create a new list initialized with the first element of lst\n    new_list = [lst[0]] if lst else []\n    # Iterate over the elements of lst starting from the second element\n    for num in lst[1:]:\n        # If the last element of new_list is not equal to num, appending num to new_list\n        if new_list[-1] != num:\n            new_list.append(num)\n    # Return the new_list\n    return new_list\n\nclass TestRemoveAdjacentDuplicates(unittest.TestCase):\n    def test_basic_functionality(self):\n        self.assertEqual(remove_adjacent_duplicates([1, 2, 2, 3, 3, 3, 4]), [1, 2, 3, 4])\n    def test_repeated_elements(self):\n        self.assertEqual(remove_adjacent_duplicates([5, 5, 5, 6, 7, 7]), [5, 6, 7])\n    def test_multiple_duplicates(self):\n        self.assertEqual(remove_adjacent_duplicates([1, 2, 3, 4, 4, 4, 4, 5, 5]), [1, 2, 3, 4, 5])\nif __name__ == '__main__':\n    unittest.main()",
